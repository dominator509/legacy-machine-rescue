{
  "enabled": true,
  "name": "Scan for secrets and personal names before commit",
  "description": "Catch keys, tokens, emails and personal names in changed files.",
  "version": "1",
  "when": { "type": "fileEdited", "patterns": ["**/*.py", "**/*.md", "**/*.json", "**/*.sh"] },
  "then": { "type": "askAgent", "prompt": "Check the edited file for API keys, tokens, passwords, private email addresses and personal names. Remove any you find and tell me." }
}
